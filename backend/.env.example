APP_NAME="Salon Platform API"
ENVIRONMENT=local
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salon_platform
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

user=postgres
password=[]
host=
port=5432
dbname=postgres
BACKEND_CORS_ORIGINS=["http://localhost:19006","http://localhost:3000"]
WALKIN_BASE_URL=http://localhost:3000/s
PUBLIC_API_BASE_URL=https://api.salones.in

CUSTOMER_CANCELLATION_CUTOFF_MINUTES=120
ALLOW_LATE_CANCELLATION_REQUESTS=true

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# Optional Firebase push delivery. Keep the JSON on one line.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optional Redis cache, booking idempotency, and rate limiting.
# Native Python: point this at a separately running Redis instance.
# REDIS_URL=redis://localhost:6379/0
# Docker Compose defaults to redis://redis:6379/0; its Redis port is not published.

# Optional Cloudflare R2 storage.
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=salon-images
# R2_PUBLIC_URL=https://media.example.com


# ==============================
# UPSTASH REDIS
# ==============================
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# SUBSCRIPTION PROVIDER
# ==============================
# Owner subscription billing. 'none' (default) = no external calls, billing endpoints answer 503,
# no checkout. 'razorpay' = one-time Orders for ONE paid period, manual renewal (SUBSCRIPTIONS.md).
# Independent of PAYMENT_PROVIDER (bookings): neither outage disables the other.
SUBSCRIPTION_PROVIDER=none
# Only read when SUBSCRIPTION_PROVIDER=razorpay. SEPARATE from the booking RAZORPAY_* keys.
# Never commit real values; a missing value fails boot.
SUBSCRIPTION_RAZORPAY_KEY_ID=
SUBSCRIPTION_RAZORPAY_KEY_SECRET=
# Days an ended paid period keeps the benefit. NO default: required when enabled; 0 = no grace.
SUBSCRIPTION_GRACE_DAYS=
# Required to use rzp_live_ keys. Live activation is an explicit, reviewed decision.
SUBSCRIPTION_ALLOW_LIVE=false
SUBSCRIPTION_ORDER_TTL_SECONDS=3600
SUBSCRIPTION_RECONCILE_AFTER_SECONDS=600
# Turn on after enrolling super admins in Supabase TOTP MFA.
ADMIN_REQUIRE_MFA=false

# Image upload gateway requires PUBLIC_API_BASE_URL to be the externally reachable API origin.
# Keep existing PUBLIC_API_BASE_URL if already set; do not add /v1 to its value.
IMAGE_MAX_PIXELS=40000000
IMAGE_AVATAR_DIMENSION=512
IMAGE_STAFF_DIMENSION=1024
IMAGE_GALLERY_DIMENSION=1600
IMAGE_AVATAR_MAX_BYTES=512000
IMAGE_PHOTO_MAX_BYTES=1048576
# Compose media-cleanup retires only proven, unreferenced objects after this age.
MEDIA_CLEANUP_GRACE_SECONDS=86400
MEDIA_CLEANUP_INTERVAL_SECONDS=3600

# Account deletion. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required outside local/test (deletion endpoints answer 503 without it).
ACCOUNT_DELETION_SECRET=
# Fernet key(s) for bank details at rest; comma separated, first one encrypts. Empty = plain text.
PAYOUT_ENCRYPTION_KEY=
ACCOUNT_DELETION_CHALLENGE_TTL_SECONDS=600
ACCOUNT_DELETION_CONFIRMATION_TTL_SECONDS=600
ACCOUNT_DELETION_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_DELETION_MAX_ATTEMPTS=5
ACCOUNT_DELETION_MAX_RESENDS=3
ACCOUNT_DELETION_MAX_CHALLENGES_PER_HOUR=5
# Worker claims before an unsettled owner-closure refund is left for the operator and erasure proceeds.
ACCOUNT_DELETION_REFUND_MAX_ATTEMPTS=8

# ==============================
# CUSTOMER PAYMENT COLLECTION (dormant by default)
# ==============================
# 'none' = GET /v1/payments/config answers enabled=false, money endpoints answer 503,
# and no webhook route is registered. Set to an adapter name only after credentials exist.
PAYMENT_PROVIDER=none
# platform_collect = provider-side split settlement (needs the provider's Route-style feature).
# direct_to_salon is refused at boot until per-salon credentials exist.
PAYMENT_SETTLEMENT_MODEL=platform_collect
PAYMENT_CURRENCY=INR
PAYMENT_ADVANCE_PERCENT=30
PAYMENT_INTENT_TTL_SECONDS=900
PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400
PAYMENT_WEBHOOK_MAX_BODY_BYTES=262144
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
# Commission policy: NO default. A real provider with platform_collect refuses to boot until both
# are decided (percent 0-100; base = online_amount | booking_total). Blank means "not decided".
PAYMENT_PLATFORM_FEE_PERCENT=
PAYMENT_COMMISSION_BASE=
# Free-text label stamped on every commission snapshot; bump it when the rule changes.
PAYMENT_COMMISSION_POLICY_VERSION=1
# Live activation needs this explicit acknowledgement (CASHFREE_ENV=production, rzp_live_ keys).
PAYMENT_ALLOW_LIVE=false
# Seconds before an outbound provider call is treated as an unknown outcome.
PAYMENT_PROVIDER_TIMEOUT_SECONDS=15
# Not built: must stay false (failed/expired payments never release a booking automatically).
PAYMENT_AUTO_RELEASE_ENABLED=false
PAYMENT_WORKER_POLL_SECONDS=10
PAYMENT_RECONCILE_AFTER_SECONDS=600


# Only read when PAYMENT_PROVIDER=cashfree. Never commit real values.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
ONLINE_CHARGE_GATEWAY_PERCENT=
# sandbox | production (production also needs PAYMENT_ALLOW_LIVE=true)
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_WEBHOOK_VERSION=2025-01-01
# Required for platform_collect: Easy Split must be enabled on the Cashfree account.
CASHFREE_EASY_SPLIT_ENABLED=false
# Where Cashfree sends the customer after checkout (max 250 chars). notify_url is derived from
# PUBLIC_API_BASE_URL (https only): <base>/v1/webhooks/cashfree.
CASHFREE_RETURN_URL=
# Max clock skew between x-webhook-timestamp and now (replay window), seconds.
CASHFREE_WEBHOOK_TOLERANCE_SECONDS=600

# Explicit gate: no Cashfree calls until enabled with reviewed sandbox settings.
CASHFREE_ENABLED=false

# Business email: verified sender + SPF/DKIM/DMARC required before production delivery.
# Supabase password reset still uses Supabase Custom SMTP (configure in the dashboard).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=
RESEND_DOMAIN_VERIFIED=false
EMAIL_WORKER_POLL_SECONDS=10
EMAIL_MAX_ATTEMPTS=8
# Fixed allow-listed website reset URL, also configured in Supabase Auth redirect URLs.
PASSWORD_RESET_REDIRECT_URL=

# Optional error capture: credentials and submitted payloads are scrubbed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

TERMS_VERSION=2026-11-07
PRIVACY_VERSION=2026-11-07

AGE_GATE_ENFORCED=false