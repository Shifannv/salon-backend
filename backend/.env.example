APP_NAME="Salon Platform API"
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salon_platform
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Service-role key — NEVER expose to clients or commit to version control
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Firebase Cloud Messaging — paste the full service-account JSON as a single-line string
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

BACKEND_CORS_ORIGINS=["http://localhost:19006","http://localhost:3000"]

# Walk-in QR — base URL baked into QR codes (the web booking site)
# QR encodes: <WALKIN_BASE_URL>/<qr_token>
WALKIN_BASE_URL=https://salon-customer-qr-webpage.vercel.app/s

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# Cloudflare R2 object storage — presigned upload URLs for salon images / staff photos
# Get these from your Cloudflare R2 dashboard (R2 > Manage R2 API Tokens).
# Leave unset to disable the upload-URL endpoint (the rest of the API is unaffected).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=salon-images
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev

# Public API base URL — used for absolute owner QR image links
# PUBLIC_API_BASE_URL=https://apiv1.mudassirmhd.in

# Supabase pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
