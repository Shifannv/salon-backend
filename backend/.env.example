APP_NAME="Salon Platform API"
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salon_platform
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Service-role key — NEVER expose to clients or commit to version control
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Firebase Cloud Messaging — paste the full service-account JSON as a single-line string
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

BACKEND_CORS_ORIGINS=["http://localhost:19006","http://localhost:3000"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# Supabase pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
