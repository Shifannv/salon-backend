APP_NAME="Salon Platform API"
ENVIRONMENT=production
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Firebase Cloud Messaging — paste the full service-account JSON as a single-line string.
# Leave unset only if push delivery is intentionally disabled.
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Replace these with your deployed frontend origins.
BACKEND_CORS_ORIGINS=["https://your-customer-app.example.com","https://your-owner-app.example.com"]

# Walk-in QR — base URL baked into QR codes (the web booking site)
# QR encodes: <WALKIN_BASE_URL>/<qr_token>
WALKIN_BASE_URL=https://salon-customer-qr-webpage.vercel.app/s

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# Storage provider — choose "r2" (default) or "imagekit"
# STORAGE_PROVIDER=r2

# Cloudflare R2 object storage — presigned upload URLs for salon images / staff photos
# Get these from your Cloudflare R2 dashboard (R2 > Manage R2 API Tokens).
# Leave unset to disable the upload-URL endpoint (the rest of the API is unaffected).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=salon-images
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev

# ImageKit — alternative to R2 for image CDN delivery (set STORAGE_PROVIDER=imagekit)
# IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxx
# IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Public API base URL — required for ImageKit upload tickets and walkin QR absolute links
# PUBLIC_API_BASE_URL=https://apiv1.mudassirmhd.in
