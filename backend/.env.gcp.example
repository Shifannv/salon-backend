APP_NAME="Salon Platform API"
ENVIRONMENT=production
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

BACKEND_CORS_ORIGINS=["https://customer.example.com","https://owner.example.com"]
WALKIN_BASE_URL=https://www.salones.in/s
PUBLIC_API_BASE_URL=https://api.example.com

CUSTOMER_CANCELLATION_CUTOFF_MINUTES=120
ALLOW_LATE_CANCELLATION_REQUESTS=true

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# Optional Firebase push delivery. Keep the JSON on one line.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optional Redis cache, booking idempotency, and rate limiting.
# Compose defaults to this internal address; Redis is not exposed on the VM:
# REDIS_URL=redis://redis:6379/0

# Optional Cloudflare R2 storage.
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET=salon-images
# R2_PUBLIC_URL=https://media.example.com

# SUBSCRIPTION PROVIDER
# ==============================
SUBSCRIPTION_PROVIDER=none
# Enroll super admins in Supabase TOTP before enabling this on an existing deployment.
ADMIN_REQUIRE_MFA=true

# Image upload gateway requires PUBLIC_API_BASE_URL to be the externally reachable API origin.
# Keep existing PUBLIC_API_BASE_URL if already set; do not add /v1 to its value.
IMAGE_MAX_PIXELS=40000000
IMAGE_AVATAR_DIMENSION=512
IMAGE_STAFF_DIMENSION=1024
IMAGE_GALLERY_DIMENSION=1600
IMAGE_AVATAR_MAX_BYTES=512000
IMAGE_PHOTO_MAX_BYTES=1048576
# Compose media-cleanup retires only proven, unreferenced objects after this age.
MEDIA_CLEANUP_GRACE_SECONDS=86400
MEDIA_CLEANUP_INTERVAL_SECONDS=3600

# Account deletion. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required: deletion endpoints answer 503 without it. Fill on the VM only.
ACCOUNT_DELETION_SECRET=
ACCOUNT_DELETION_CHALLENGE_TTL_SECONDS=600
ACCOUNT_DELETION_CONFIRMATION_TTL_SECONDS=600
ACCOUNT_DELETION_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_DELETION_MAX_ATTEMPTS=5
ACCOUNT_DELETION_MAX_RESENDS=3
ACCOUNT_DELETION_MAX_CHALLENGES_PER_HOUR=5
# Worker claims before an unsettled owner-closure refund is left for the operator and erasure proceeds.
ACCOUNT_DELETION_REFUND_MAX_ATTEMPTS=8

# ==============================
# CUSTOMER PAYMENT COLLECTION (dormant by default)
# ==============================
# 'none' = GET /v1/payments/config answers enabled=false, money endpoints answer 503,
# and no webhook route is registered. Set to an adapter name only after credentials exist.
PAYMENT_PROVIDER=none
# platform_collect = provider-side split settlement (needs the provider's Route-style feature).
# direct_to_salon is refused at boot until per-salon credentials exist.
PAYMENT_SETTLEMENT_MODEL=platform_collect
PAYMENT_CURRENCY=INR
PAYMENT_ADVANCE_PERCENT=30
PAYMENT_INTENT_TTL_SECONDS=900
PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400
PAYMENT_WEBHOOK_MAX_BODY_BYTES=262144
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
PAYMENT_PLATFORM_FEE_PERCENT=0
PAYMENT_WORKER_POLL_SECONDS=10
PAYMENT_RECONCILE_AFTER_SECONDS=600
# Only read when PAYMENT_PROVIDER=razorpay. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ROUTE_ENABLED=false

# Explicit gate: no Cashfree calls until enabled with reviewed sandbox settings.
CASHFREE_ENABLED=false

# Business email: verified sender + SPF/DKIM/DMARC required before production delivery.
# Supabase password reset still uses Supabase Custom SMTP (configure in the dashboard).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=
RESEND_DOMAIN_VERIFIED=false
EMAIL_WORKER_POLL_SECONDS=10
EMAIL_MAX_ATTEMPTS=8
# Fixed allow-listed website reset URL, also configured in Supabase Auth redirect URLs.
PASSWORD_RESET_REDIRECT_URL=

# Optional error capture: credentials and submitted payloads are scrubbed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
