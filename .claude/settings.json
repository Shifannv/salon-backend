{
  "permissions": {
    "allow": [
      "Bash(python -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose -f docker-compose.yml config:*)",
      "Bash(docker compose --env-file .env.gcp.example -f docker-compose.yml config:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tail -n 5 docs/agent-memory/SESSIONS.md 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
