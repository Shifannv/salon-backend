{
  "permissions": {
    "allow": [
      "Bash(python -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose -f docker-compose.yml config:*)",
      "Bash(docker compose --env-file .env.gcp.example -f docker-compose.yml config:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration",
      "Bash(gcloud run services update*)",
      "Bash(git push:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(npm install:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tail -n 5 docs/agent-memory/SESSIONS.md 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/skill_router.py session",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/skill_router.py subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Lenovo/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Lenovo/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
